{
  "name": "teamshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "concurrently -n app,web,worker -c blue,magenta,yellow \"npm:dev:app\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:app": "npm run dev -w @teamshelf/app",
    "dev:web": "npm run dev -w @teamshelf/web",
    "dev:worker": "npm run dev:worker -w @teamshelf/app",
    "build": "npm run build -w @teamshelf/contracts && npm run build -w @teamshelf/app && npm run build -w @teamshelf/web",
    "migrate": "npm run migrate -w @teamshelf/app",
    "migrate:undo": "npm run migrate:undo -w @teamshelf/app",
    "seed:admin": "npm run seed:admin -w @teamshelf/app",
    "admin:create-bootstrap-invitation": "npm run admin:create-bootstrap-invitation -w @teamshelf/app --",
    "test": "npm run test -w @teamshelf/contracts && npm run test -w @teamshelf/app && npm run test -w @teamshelf/web",
    "test:integration": "npm run test:integration -w @teamshelf/app",
    "test:e2e": "npm run test:e2e -w @teamshelf/web",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
