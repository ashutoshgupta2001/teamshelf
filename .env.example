NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgres://teamshelf:teamshelf@localhost:5432/teamshelf
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

SESSION_COOKIE_NAME=teamshelf_session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=14
CSRF_SECRET=replace-with-another-32-character-secret

# Required by the Docker seed service. Change both before deployment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_DISPLAY_NAME=TeamShelf Admin
INITIAL_ADMIN_WORKSPACE_NAME=TeamShelf

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
VITE_GOOGLE_CLIENT_ID=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@teamshelf.local
SMTP_FROM_NAME=TeamShelf

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
GCP_KEY_FILE=
SIGNED_UPLOAD_URL_TTL_SECONDS=600
SIGNED_DOWNLOAD_URL_TTL_SECONDS=300

MAX_FILE_SIZE_MB=250
WORKSPACE_STORAGE_LIMIT_GB=20
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation

INVITATION_EXPIRY_DAYS=7
SHARE_LINK_DEFAULT_EXPIRY_DAYS=7
SHARE_LINK_MAX_EXPIRY_DAYS=30
TRASH_RETENTION_DAYS=30

JOB_POLL_INTERVAL_MS=3000
JOB_MAX_ATTEMPTS=5
JOB_LOCK_TIMEOUT_SECONDS=120
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
